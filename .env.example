# PrivacyAware-PenAgent — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Metasploit RPC Daemon ──────────────────────────────────────────────────────
# Start with: sudo msfrpcd -U msf -P <your_password> -a 127.0.0.1 -p 55553
# Both MSF_RPC_PASS and MSF_RPC_PASSWORD are accepted.
MSF_RPC_HOST=127.0.0.1
MSF_RPC_PORT=55553
MSF_RPC_PASS=msfpassword
MSF_RPC_SSL=false

# ── Ollama Local LLM ──────────────────────────────────────────────────────────
# Both OLLAMA_HOST and OLLAMA_BASE_URL are accepted.
# Start with: ollama serve
#
# Task-aware model routing is configured in src/config/models.yaml:
#   ollama pull hf.co/QuantFactory/Foundation-Sec-8B-GGUF:Q4_K_M  # synthesis
#   ollama pull qwen2.5-coder:14b                                  # generation (JSON)
#   ollama pull monotykamary/whiterabbitneo-v1.5a:latest            # synthesis fallback
#
# OLLAMA_MODEL_LOCAL is the legacy fallback when models.yaml lookup fails.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_LOCAL=llama3:8b

# ── Cloud LLM (Optional — used only when router routes to CLOUD) ───────────────
# Leave blank to always fall back to local Ollama.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
